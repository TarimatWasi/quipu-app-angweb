{
  "name": "quipu-app-angweb",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/set-env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/set-env.mjs",
    "build": "ng build --configuration production",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "ng lint",
    "contract:sync": "node scripts/contract.mjs sync",
    "contract:check": "node scripts/contract.mjs check",
    "contract:pin": "node scripts/contract.mjs pin",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test": "ng test --watch=false --coverage",
    "pretest": "node scripts/set-env.mjs",
    "verify": "npm run format:check && npm run contract:check && npm run lint && npm run test:scripts && npm run build && npm run test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0",
    "npm": ">=10"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
