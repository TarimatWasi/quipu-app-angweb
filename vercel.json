{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/TAR-300-csrf": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-LMY6wYoFV9I4wWzxaq1N/dTpl4iurQktw706UCHK3vM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/bff/:path*",
      "has": [
        {
          "type": "host",
          "value": "^quipu-dev[.]tarimatwasi[.]com$"
        }
      ],
      "destination": "https://quipu-api-dev.onrender.com/bff/:path*"
    },
    {
      "source": "/bff/:path*",
      "has": [
        {
          "type": "host",
          "value": "^quipu-git-[a-z0-9-]+[.]vercel[.]app$"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "^quipu-git-main-[a-z0-9-]+[.]vercel[.]app$"
        }
      ],
      "destination": "https://quipu-api-dev.onrender.com/bff/:path*"
    }
  ]
}
